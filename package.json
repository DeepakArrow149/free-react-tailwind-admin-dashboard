{
  "name": "stitch-erp-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Production-ready enterprise React admin template with modular architecture",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
