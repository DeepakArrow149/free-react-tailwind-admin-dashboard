    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "postcss": "^8.5.2",
    "prettier": "^3.4.2",
    "rollup-plugin-visualizer": "^5.13.1",
    "tailwindcss": "^4.0.8",
    "typescript": "~5.7.2",
